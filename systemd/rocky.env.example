# Secrets and machine-specific settings for Rocky.
# Install to /etc/rocky/rocky.env and chmod 600 - it holds your API key.

# Required for conversation. Without it Rocky still moves, watches and chirps,
# but cannot talk.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides. Double underscore separates config levels.
#ROCKY_LOG_LEVEL=DEBUG
#ROCKY_WEB__PORT=8080
#ROCKY_BRAIN__EFFORT=medium
